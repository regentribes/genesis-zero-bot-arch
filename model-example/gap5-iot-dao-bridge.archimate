<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:archimate="http://www.archimatetool.com/archimate"
  name="IoT DAO Governance Bridge - Gap 5 Integration"
  id="model-iot-dao-bridge"
  version="1.0.0">

  <property key="domain" value="regenerative-community"/>
  <property key="layer" value="all"/>
  <property key="gap" value="gap-5"/>
  <property key="status" value="proposed"/>

  <!-- ============ MOTIVATION LAYER ============ -->

  <!-- Drivers -->
  <element xsi:type="archimate:Driver" id="driver-sensor-trust" name="Need for Sensor-Verified Governance">
    <documentation>DAO decisions must be grounded in physical-world sensor data to maintain legitimacy and effectiveness</documentation>
  </element>
  <element xsi:type="archimate:Driver" id="driver-governance-integrity" name="Governance Integrity Requirement">
    <documentation>Governance claims must be verifiable against real-world conditions to prevent contradiction between decisions and reality</documentation>
  </element>
  <element xsi:type="archimate:Driver" id="driver-cross-module-inference" name="Cross-Module Correlation">
    <documentation>DHT22 shared latent enables correlated inference across physical modules for higher-confidence governance claims</documentation>
  </element>

  <!-- Outcomes -->
  <element xsi:type="archimate:Outcome" id="outcome-verified-governance" name="Sensor-Verified DAO Decisions">
    <documentation>DAO governance decisions are grounded in and verified by physical sensor data</documentation>
  </element>
  <element xsi:type="archimate:Outcome" id="outcome-audit-trail" name="Complete Audit Trail">
    <documentation>Every governance decision has a traceable chain from sensor reading through ITC verification to CDS deliberation to FRS recording</documentation>
  </element>
  <element xsi:type="archimate:Outcome" id="outcome-contradiction-detection" name="Real-Time Contradiction Detection">
    <documentation>ITC detects contradictions between DAO claims and physical reality before decisions become harmful</documentation>
  </element>

  <!-- Stakeholders -->
  <element xsi:type="archimate:Stakeholder" id="stakeholder-sensor-owner" name="Sensor Owner">
    <documentation>Community member operating physical IoT sensor hardware (water tank, soil moisture, solar, DHT22)</documentation>
  </element>
  <element xsi:type="archimate:Stakeholder" id="stakeholder-dao-member" name="DAO Member">
    <documentation>Community member participating in governance decisions via CDS voting</documentation>
  </element>
  <element xsi:type="archimate:Stakeholder" id="stakeholder-itc" name="ITC System">
    <documentation>Integral TRIZ Constructor - automated contradiction detection and verification system</documentation>
  </element>

  <!-- ============ BUSINESS LAYER ============ -->

  <!-- Actors -->
  <element xsi:type="archimate:BusinessActor" id="actor-sensor-owner" name="Sensor Owner">
    <documentation>Community member who deploys and maintains IoT hardware. Provides sensory input to governance via physical measurement.</documentation>
  </element>
  <element xsi:type="archimate:BusinessActor" id="actor-dao-member" name="DAO Member">
    <documentation>Community member who votes on governance decisions in CDS deliberation. Consumes ITC-verified sensor claims.</documentation>
  </element>
  <element xsi:type="archimate:BusinessActor" id="actor-itc-system" name="ITC (Integral TRIZ Constructor)">
    <documentation>Automated system that detects contradictions between sensor data and DAO claims. Validates evidence and emits verified claims to CDS.</documentation>
  </element>
  <element xsi:type="archimate:BusinessActor" id="actor-cds-deliberation" name="CDS (Collective Decision System)">
    <documentation>Governance layer that proposes votes, counts weighted consensus, and enacts decisions based on ITC-verified claims.</documentation>
  </element>
  <element xsi:type="archimate:BusinessActor" id="actor-cos-execution" name="COS (Commons Operating System)">
    <documentation>Resource layer that executes physical actions (irrigation, water allocation, energy management) based on CDS decisions.</documentation>
  </element>
  <element xsi:type="archimate:BusinessActor" id="actor-frs-audit" name="FRS (Federation Rules System)">
    <documentation>Protocol layer that records audit trails and validates governance decisions against federation rules.</documentation>
  </element>

  <!-- Business Services -->
  <element xsi:type="archimate:BusinessService" id="service-sensor-ingestion" name="Sensor Ingestion Service">
    <documentation>Collects readings from all IoT modules (water tank, soil moisture, solar powerbank, DHT22) and ingests into evidence store</documentation>
  </element>
  <element xsi:type="archimate:BusinessService" id="service-evidence-brokering" name="Evidence Brokering Service">
    <documentation>SurrealDB-based state broker that stores sensor evidence, links causal relationships, and serves as ITC query backend</documentation>
  </element>
  <element xsi:type="archimate:BusinessService" id="service-governance-verification" name="Governance Verification Service">
    <documentation>Transforms sensor readings into governance claims and verifies them through ITC contradiction detection</documentation>
  </element>
  <element xsi:type="archimate:BusinessService" id="service-audit-recording" name="Audit Recording Service">
    <documentation>FRS records full evidence chain from sensor to governance decision for regulatory and retrospective verification</documentation>
  </element>

  <!-- Business Processes -->
  <element xsi:type="archimate:BusinessProcess" id="process-sensor-read" name="Sensor Reading Capture">
    <documentation>ESP32 modules capture physical measurements: water tank %, soil moisture %, solar SOC, temperature, humidity</documentation>
  </element>
  <element xsi:type="archimate:BusinessProcess" id="process-evidence-store" name="Evidence Storage">
    <documentation>Sensor readings stored in SurrealDB with timestamp, module_id, value, confidence, anomaly flags</documentation>
  </element>
  <element xsi:type="archimate:BusinessProcess" id="process-itc-verify" name="ITC Verification">
    <documentation>ITC queries evidence store, detects contradictions, validates cross-module correlations, emits verified claims</documentation>
  </element>
  <element xsi:xsi:type="archimate:BusinessProcess" id="process-cds-deliberate" name="CDS Deliberation">
    <documentation>CDS receives ITC verified claims, proposes governance votes, tallies weighted consensus, enacts decisions</documentation>
  </element>
  <element xsi:type="archimate:BusinessProcess" id="process-cos-execute" name="COS Execution">
    <documentation>COS executes physical actions (irrigation, water release, energy management) based on CDS decisions</documentation>
  </element>
  <element xsi:type="archimate:BusinessProcess" id="process-frs-record" name="FRS Audit Recording">
    <documentation>FRS records full governance chain: sensor → ITC → CDS → COS → FRS for audit and retrospective verification</documentation>
  </element>
  <element xsi:type="archimate:BusinessProcess" id="process-oad-constrain" name="OAD Constraint Validation">
    <documentation>OAD validates bridge architecture against architectural constraints and community governance rules</documentation>
  </element>

  <!-- Business Events -->
  <element xsi:type="archimate:BusinessEvent" id="event-sensor-reading" name="Sensor Reading Event">
    <documentation>Triggered when IoT module reports new measurement. Initiates evidence capture and bridge processing.</documentation>
  </element>
  <element xsi:type="archimate:BusinessEvent" id="event-itc-verified" name="ITC Verified Claim Event">
    <documentation>Triggered when ITC resolves a claim. Feeds CDS deliberation for governance decision.</documentation>
  </element>
  <element xsi:type="archimate:BusinessEvent" id="event-cds-decision" name="CDS Decision Event">
    <documentation>Triggered when CDS enacts a governance decision. Feeds COS execution and FRS audit.</documentation>
  </element>
  <element xsi:type="archimate:BusinessEvent" id="event-contradiction-detected" name="Contradiction Detected Event">
    <documentation>Triggered when ITC identifies mismatch between sensor data and DAO claim. Triggers governance recalibration.</documentation>
  </element>
  <element xsi:type="archimate:BusinessEvent" id="event-cross-module-inference" name="Cross-Module Inference Event">
    <documentation>Triggered when DHT22 latent correlates across multiple modules. Generates high-confidence aggregated governance claim.</documentation>
  </element>

  <!-- ============ APPLICATION LAYER ============ -->

  <!-- Application Services -->
  <element xsi:type="archimate:ApplicationService" id="app-service-active-inference-bridge" name="Active Inference Bridge">
    <documentation>Bayesian state estimation engine that receives sensor readings and converts them to governance evidence using POMDP framework. Implements belief updating against sensor data. Correlates DHT22 latent across modules.</documentation>
  </element>
  <element xsi:type="archimate:ApplicationService" id="app-service-surrealdb-broker" name="SurrealDB State Broker">
    <documentation>State broker storing all sensor evidence with causal links to derived claims. Serves as ITC query backend for contradiction detection. Maintains ITC resolution status per claim.</documentation>
  </element>
  <element xsi:type="archimate:ApplicationService" id="app-service-itc-resolver" name="ITC Resolver">
    <documentation>Integral TRIZ Constructor resolver: contradiction detection, cross-module correlation validation, missing data estimation. Emits verified or contradicted claims to CDS.</documentation>
  </element>
  <element xsi:type="archimate:ApplicationService" id="app-service-cds-updater" name="CDS State Updater">
    <documentation>Updates CDS governance state based on ITC verified claims. Proposes votes, counts consensus, enacts decisions. Records governance history for FRS audit.</documentation>
  </element>
  <element xsi:type="archimate:ApplicationService" id="app-service-cos-actuator" name="COS Actuator Controller">
    <documentation>Translates CDS decisions into actuator commands for physical systems (drip irrigation, water valves, energy routing).</documentation>
  </element>
  <element xsi:type="archimate:ApplicationService" id="app-service-frs-recorder" name="FRS Audit Recorder">
    <documentation>Records full governance chain to immutable audit trail. Provides retrospective verification queries and contradiction chain analysis.</documentation>
  </element>

  <!-- Application Components -->
  <element xsi:type="archimate:ApplicationComponent" id="app-pomdp-engine" name="POMDP State Engine">
    <documentation>Part of Active Inference Bridge. Maintains POMDP state representation for all sensor modules. Updates beliefs as new sensor readings arrive.</documentation>
  </element>
  <element xsi:type="archimate:ApplicationComponent" id="app-causal-model-library" name="Causal Model Library">
    <documentation>Part of Active Inference Bridge. Stores Bayes Net structures for each sensor type. Enables causal reasoning about sensor correlations (e.g., DHT22 → soil moisture inference).</documentation>
  </element>
  <element xsi:type="archimate:ApplicationComponent" id="app-continual-learning" name="Continual Learning Module">
    <documentation>Detects concept drift in sensor readings. Marks degraded-confidence evidence when sensors go offline. Triggers retroactive verification when sensors recover.</documentation>
  </element>

  <!-- Application Interfaces -->
  <element xsi:type="archimate:ApplicationInterface" id="iface-sensor-rest" name="IoT REST API">
    <documentation>ESP32 REST API endpoint for polling sensor readings. Supports JSON payload with module_id, reading, timestamp.</documentation>
  </element>
  <element xsi:type="archimate:ApplicationInterface" id="iface-itc-query" name="ITC Query API">
    <documentation>SurrealDB query interface for ITC contradiction detection. Returns evidence chains and confidence scores.</documentation>
  </element>
  <element xsi:type="archimate:ApplicationInterface" id="iface-cds-deliberation" name="CDS Deliberation API">
    <documentation>CDS vote proposal, consensus tally, and decision enactment API. Consumes ITC verified claims.</documentation>
  </element>

  <!-- Application Data Objects -->
  <element xsi:type="archimate:DataObject" id="data-evidence-record" name="Sensor Evidence Record">
    <documentation>JSON record in SurrealDB: timestamp, module_id, reading_value, confidence_score, anomaly_flag, causal_links, itc_resolution_status</documentation>
  </element>
  <element xsi:type="archimate:DataObject" id="data-governance-claim" name="Governance Claim">
    <documentation>ITC output: claim_id, source_evidence_ids, confidence, contradiction_status, cross_module_flag, timestamp</documentation>
  </element>
  <element xsi:type="archimate:DataObject" id="data-audit-chain" name="Governance Audit Chain">
    <documentation>FRS immutable record: sensor_reading → itc_verification → cds_decision → cos_execution → frs_confirmation</documentation>
  </element>

  <!-- ============ TECHNOLOGY LAYER ============ -->

  <!-- Nodes / Devices -->
  <element xsi:type="archimate:Node" id="node-esp32-water-tank" name="ESP32 - Water Tank Sensor">
    <documentation>ESP32 with ultrasonic distance sensor. Measures water tank level. Reports every 5 minutes via REST to bridge.</documentation>
  </element>
  <element xsi:type="archimate:Node" id="node-esp32-soil-moisture" name="ESP32 - Soil Moisture Sensor">
    <documentation>ESP32 with capacitive soil moisture probe. Measures volumetric water content. Triggers irrigation claim when below threshold.</documentation>
  </element>
  <element xsi:type="archimate:Node" id="node-esp32-solar-powerbank" name="ESP32 - Solar Powerbank Monitor">
    <documentation>ESP32 monitoring solar SOC, charge current, discharge current. Reports energy availability for governance allocation.</documentation>
  </element>
  <element xsi:type="archimate:Node" id="node-esp32-dht22" name="ESP32 - DHT22 Temperature/Humidity">
    <documentation>ESP32 with DHT22 sensor. Shared latent variable for cross-module inference. Reports temperature and humidity every 3 minutes.</documentation>
  </element>
  <element xsi:type="archimate:Node" id="node-wifi-hub" name="WiFi Mesh Hub">
    <documentation>ESP32 mesh radio hub. Aggregates sensor traffic and provides local network for IoT modules. Supports Telegram bot connectivity.</documentation>
  </element>
  <element xsi:type="archimate:Node" id="node-edge-server" name="Edge Server (HP EliteBook)">
    <documentation>Local VPS hosting SurrealDB, Active Inference Bridge, ITC resolver, CDS deliberation. Runs NixOS with full self-hosting.</documentation>
  </element>
  <element xsi:type="archimate:Node" id="node-telegram-bot" name="Telegram Bot Gateway">
    <documentation>Genesis bot on Telegram. Receives governance notifications and provides community interface to IoT-governance bridge.</documentation>
  </element>

  <!-- Artifacts -->
  <element xsi:type="archimate:Artifact" id="art-sensor-reading-payload" name="Sensor Reading JSON Payload">
    <documentation>JSON payload from ESP32 sensors: {module_id, timestamp, reading_type, value, unit, confidence}</documentation>
  </element>
  <element xsi:type="archimate:Artifact" id="art-evidence-db" name="SurrealDB Evidence Database">
    <documentation>SurrealDB namespace: semantic_graph/main. Contains all sensor evidence records, governance claims, ITC resolution status.</documentation>
  </element>
  <element xsi:type="archimate:Artifact" id="art-governance-state" name="Governance State Store">
    <documentation>CDS current governance state: active votes, passed decisions, allocation policies, community member weights.</documentation>
  </element>
  <element xsi:type="archimate:Artifact" id="art-audit-log" name="FRS Immutable Audit Log">
    <documentation>Append-only audit log recording full governance chain per decision. Hash-chained for tamper evidence.</documentation>
  </element>

  <!-- Software / System -->
  <element xsi:type="archimate:SystemSoftware" id="sw-surrealdb" name="SurrealDB (State Broker)">
    <documentation>SurrealDB running as systemd service. WebSocket interface at ws://127.0.0.1:8000. Namespace: semantic_graph/main.</documentation>
  </element>
  <element xsi:type="archimate:SystemSoftware" id="sw-active-inference-engine" name="Active Inference Engine">
    <documentation>Python/Nix application implementing POMDP state estimation, Bayes Net causal models, belief updating.</documentation>
  </element>
  <element xsi:type="archimate:SystemSoftware" id="sw-itc-resolver" name="ITC Resolver (TRIZ Constructor)">
    <documentation>Python/Nix application implementing contradiction detection, cross-module correlation, missing data estimation.</documentation>
  </element>
  <element xsi:type="archimate:SystemSoftware" id="sw-cds-deliberation" name="CDS Deliberation Engine">
    <documentation>Python/Nix application implementing weighted consensus voting, decision proposal, governance state updates.</documentation>
  </element>

  <!-- ============ RELATIONSHIPS ============ -->

  <!-- Sensor data flow: ESP32 → Active Inference Bridge → SurrealDB -->
  <element xsi:type="archimate:Relationship" id="rel-sensor-to-bridge" type="flow" source="#node-esp32-water-tank" target="#app-service-active-inference-bridge">
    <documentation>Raw sensor readings flow from ESP32 modules to Active Inference Bridge</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-bridge-to-evidence" type="composition" source="#app-service-active-inference-bridge" target="#app-service-surrealdb-broker">
    <documentation>Bridge writes evidence records to SurrealDB state broker</documentation>
  </element>

  <!-- ITC verification flow -->
  <element xsi:type="archimate:Relationship" id="rel-evidence-to-itc" type="flow" source="#app-service-surrealdb-broker" target="#app-service-itc-resolver">
    <documentation>SurrealDB evidence store queried by ITC for contradiction detection</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-itc-to-cds" type="flow" source="#app-service-itc-resolver" target="#app-service-cds-updater">
    <documentation>ITC verified claims feed CDS deliberation for governance decisions</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-cds-to-cos" type="flow" source="#app-service-cds-updater" target="#app-service-cos-actuator">
    <documentation>CDS decisions trigger COS execution of physical actions</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-cos-to-frs" type="flow" source="#app-service-cos-actuator" target="#app-service-frs-recorder">
    <documentation>COS execution records feed FRS audit trail</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-itc-contradiction-to-cds" type="triggering" source="#app-service-itc-resolver" target="#app-service-cds-updater">
    <documentation>ITC contradiction detection triggers CDS governance recalibration</documentation>
  </element>

  <!-- Five-subsystem governance loop -->
  <element xsi:type="archimate:Relationship" id="rel-oad-constrains" type="serving" source="#actor-itc-system" target="#process-oad-constrain">
    <documentation>OAD provides architectural constraint validation for ITC operation</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-itc-synthesizes" type="serving" source="#actor-itc-system" target="#process-itc-verify">
    <documentation>ITC synthesizes sensor evidence for governance verification</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-cds-deliberates" type="serving" source="#actor-cds-deliberation" target="#process-cds-deliberate">
    <documentation>CDS deliberates on ITC-verified claims and enacts governance decisions</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-cos-executes" type="serving" source="#actor-cos-execution" target="#process-cos-execute">
    <documentation>COS executes physical resource actions based on CDS decisions</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-frs-records" type="serving" source="#actor-frs-audit" target="#process-frs-record">
    <documentation>FRS records full governance chain for audit and retrospective verification</documentation>
  </element>

  <!-- Cross-module DHT22 inference -->
  <element xsi:type="archimate:Relationship" id="rel-dht22-cross-module" type="association" source="#node-esp32-dht22" target="#app-pomdp-engine">
    <documentation>DHT22 shared latent feeds POMDP engine for cross-module correlated inference</documentation>
  </element>

  <!-- Motivation layer influence on architecture -->
  <element xsi:type="archimate:Relationship" id="rel-driver-influences" type="influence" source="#driver-sensor-trust" target="#app-service-active-inference-bridge">
    <documentation>Sensor trust requirement shapes Active Inference Bridge design</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-outcome-realizes" type="realization" source="#app-service-governance-verification" target="#outcome-verified-governance">
    <documentation>Governance Verification Service realizes sensor-verified governance outcome</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-outcome-audit-realizes" type="realization" source="#app-service-audit-recording" target="#outcome-audit-trail">
    <documentation>Audit Recording Service realizes complete audit trail outcome</documentation>
  </element>

  <!-- Stakeholder assignments -->
  <element xsi:type="archimate:Relationship" id="rel-stakeholder-assigns-sensor" type="assignment" source="#stakeholder-sensor-owner" target="#actor-sensor-owner">
    <documentation>Sensor Owner stakeholder assigned to Sensor Owner business actor</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-stakeholder-assigns-dao" type="assignment" source="#stakeholder-dao-member" target="#actor-dao-member">
    <documentation>DAO Member stakeholder assigned to DAO Member business actor</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-stakeholder-assigns-itc" type="assignment" source="#stakeholder-itc" target="#actor-itc-system">
    <documentation>ITC System stakeholder assigned to ITC business actor</documentation>
  </element>

  <!-- Data flow relationships -->
  <element xsi:type="archimate:Relationship" id="rel-evidence-data-flow" type="composition" source="#app-service-surrealdb-broker" target="#data-evidence-record">
    <documentation>SurrealDB broker composes evidence records data objects</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-claim-data-flow" type="composition" source="#app-service-itc-resolver" target="#data-governance-claim">
    <documentation>ITC resolver composes governance claim data objects</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-audit-data-flow" type="composition" source="#app-service-frs-recorder" target="#data-audit-chain">
    <documentation>FRS recorder composes audit chain data objects</documentation>
  </element>

  <!-- Technology to application serving -->
  <element xsi:type="archimate:Relationship" id="rel-edge-servers-sw" type="serving" source="#node-edge-server" target="#sw-active-inference-engine">
    <documentation>Edge server hosts Active Inference Engine software</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-edge-servers-surrealdb" type="serving" source="#node-edge-server" target="#sw-surrealdb">
    <documentation>Edge server hosts SurrealDB state broker</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-wifi-hub-aggregates" type="serving" source="#node-wifi-hub" target="#iface-sensor-rest">
    <documentation>WiFi mesh hub aggregates ESP32 sensor traffic and exposes REST API</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-telegram-gateway" type="serving" source="#node-telegram-bot" target="#service-governance-verification">
    <documentation>Telegram bot provides community interface to governance verification service</documentation>
  </element>

  <!-- Artifact assignments -->
  <element xsi:type="archimate:Relationship" id="rel-artifact-db-assign" type="assignment" source="#sw-surrealdb" target="#art-evidence-db">
    <documentation>SurrealDB software manages evidence database artifact</documentation>
  </element>
  <element xsi:type="archimate:Relationship" id="rel-artifact-audit-assign" type="assignment" source="#sw-cds-deliberation" target="#art-audit-log">
    <documentation>CDS deliberation engine writes to immutable audit log</documentation>
  </element>

</archimate:model>
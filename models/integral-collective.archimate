<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Integral Collective Node" id="model-integral-collective" version="1.0.0">
  <property key="domain" value="integral-collective"/>
  <property key="layer" value="all"/>
  <folder name="Business" id="folder-business" type="business">
    <element xsi:type="archimate:BusinessActor" id="actor-oad" name="OAD Subsystem" documentation="Open Architecture Design — strategic positioning and system design."/>
    <element xsi:type="archimate:BusinessActor" id="actor-itc" name="ITC Subsystem" documentation="Integral TRIZ Constructor — innovation and problem-solving."/>
    <element xsi:type="archimate:BusinessActor" id="actor-cds" name="CDS Subsystem" documentation="Collective Decision System — governance and decision-making."/>
    <element xsi:type="archimate:BusinessActor" id="actor-cos" name="COS Subsystem" documentation="Commons Operating System — resource management and allocation."/>
    <element xsi:type="archimate:BusinessActor" id="actor-frs" name="FRS Subsystem" documentation="Federation Rules System — protocol and standard enforcement."/>
    <element xsi:type="archimate:BusinessProcess" id="proc-oad-strategy" name="Strategy Formulation" documentation="Develops and maintains system strategy."/>
    <element xsi:type="archimate:BusinessProcess" id="proc-cds-consensus" name="Consensus Building" documentation="Builds consensus across node participants."/>
    <element xsi:type="archimate:BusinessProcess" id="proc-cos-tracking" name="Resource Tracking" documentation="Tracks resource usage and availability."/>
    <element xsi:type="archimate:BusinessProcess" id="proc-frs-updates" name="Rule Updates" documentation="Manages updates to federation rules."/>
    <element xsi:type="archimate:BusinessService" id="srv-oad-design" name="Architecture Design Service" documentation="Designs system architecture aligned with Integral Collective principles."/>
    <element xsi:type="archimate:BusinessService" id="srv-itc-innovation" name="Innovation Service" documentation="Applies TRIZ problem-solving for novel challenges."/>
    <element xsi:type="archimate:BusinessService" id="srv-cds-voting" name="Decision Voting Service" documentation="Facilitates collective decision-making."/>
    <element xsi:type="archimate:BusinessService" id="srv-cos-allocation" name="Resource Allocation Service" documentation="Manages shared resource allocation."/>
    <element xsi:type="archimate:BusinessService" id="srv-frs-compliance" name="Compliance Service" documentation="Enforces federation rules and standards."/>
  </folder>
  <folder name="Application" id="folder-application" type="application">
    <element xsi:type="archimate:ApplicationComponent" id="app-ead" name="EAD Engine" documentation="Evolutionary Algorithm Design for system optimization."/>
    <element xsi:type="archimate:ApplicationComponent" id="app-triz" name="TRIZ Engine" documentation="Problem-solving engine using 40 inventive principles."/>
    <element xsi:type="archimate:ApplicationComponent" id="app-fcl" name="FCL Processor" documentation="Formation Coding Language processor for spatial coordination."/>
    <element xsi:type="archimate:ApplicationComponent" id="app-wiki" name="Wiki Engine" documentation="OpenClaw wiki for knowledge management."/>
    <element xsi:type="archimate:ApplicationComponent" id="app-adr" name="ADR Engine" documentation="Architecture decision record management."/>
  </folder>
  <folder name="Technology &amp; Physical" id="folder-technology" type="technology">
    <element xsi:type="archimate:Node" id="node-primary" name="Primary Node" documentation="Main compute node for Integral Collective operations."/>
    <element xsi:type="archimate:Node" id="node-federated" name="Federated Node" documentation="Distributed node for cross-collective coordination."/>
    <element xsi:type="archimate:Artifact" id="art-ead-weights" name="EAD Model Weights" documentation="Neural network weights for evolutionary algorithm."/>
    <element xsi:type="archimate:Artifact" id="art-triz-db" name="TRIZ Database" documentation="Contradiction matrix and inventive principle database."/>
    <element xsi:type="archimate:Artifact" id="art-fcl-rules" name="FCL Rules" documentation="Formation Coding Language grammar and rules."/>
  </folder>
  <folder name="Motivation" id="folder-motivation" type="motivation">
    <element xsi:type="archimate:Goal" id="goal-self-governance" name="Self-Governance" documentation="Integral Collective governs itself without external control."/>
    <element xsi:type="archimate:Goal" id="goal-post-monetary" name="Post-Monetary Exchange" documentation="Resource exchange without traditional currency."/>
    <element xsi:type="archimate:Goal" id="goal-regenerative" name="Regenerative Operations" documentation="All operations contribute to regenerative outcomes."/>
    <element xsi:type="archimate:Principle" id="prin-evidence" name="Evidence-Based" documentation="Decisions grounded in measurable evidence."/>
    <element xsi:type="archimate:Principle" id="prin-consensus" name="Consensus-Oriented" documentation="Decisions seek broad consensus before execution."/>
    <element xsi:type="archimate:Principle" id="prin-transparency" name="Full Transparency" documentation="All governance and resource decisions are transparent."/>
    <element xsi:type="archimate:Capability" id="cap-evolution" name="Evolutionary Adaptation" documentation="System evolves based on feedback and outcomes."/>
    <element xsi:type="archimate:Capability" id="cap-triz" name="TRIZ Problem Solving" documentation="Novel solutions to contradictions."/>
    <element xsi:type="archimate:Capability" id="cap-federation" name="Federation Management" documentation="Coordinate across multiple Integral Collective nodes."/>
  </folder>
</archimate:model>
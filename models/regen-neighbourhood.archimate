<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Regenerative Neighbourhood Core Architecture" id="model-regen-neighbourhood" version="1.0.0">
  <property key="domain" value="regenerative-community"/>
  <property key="layer" value="all"/>
  <property key="holon_type" value="micro"/>
  <folder name="Strategy" id="folder-strategy" type="strategy">
    <element xsi:type="archimate:Plateau" id="plateau-v2" name="Edge-Native" documentation="All operations on local HP nodes, full mesh sync, ArchiMate portal."/>
    <element xsi:type="archimate:Gap" id="gap-mesh-protocol" name="Mesh Protocol Gap" documentation="Need to finalize Raft consensus implementation for mesh radio."/>
    <element xsi:type="archimate:Gap" id="gap-fcl" name="FCL Implementation" documentation="Formation Coding Language prototype in Manim pending deployment."/>
  </folder>
  <folder name="Business" id="folder-business" type="business">
    <element xsi:type="archimate:BusinessActor" id="actor-practitioner" name="Community Practitioner" documentation="Individual member contributing to and benefiting from the commons."/>
    <element xsi:type="archimate:BusinessActor" id="actor-collective" name="Collective Node" documentation="Regional grouping of Holons with shared governance."/>
    <element xsi:type="archimate:BusinessActor" id="actor-holon" name="Holon Unit" documentation="Local biome self-governance unit. Self-contained but connected to meso/macro levels."><property key="holon_type" value="micro"/></element>
    <element xsi:type="archimate:BusinessRole" id="role-catalyst" name="Catalyst" documentation="Egregore role: initiates action, identifies opportunities."/>
    <element xsi:type="archimate:BusinessRole" id="role-stabilizer" name="Stabilizer" documentation="Egregore role: maintains consistency, reduces entropy."/>
    <element xsi:type="archimate:BusinessRole" id="role-synthesizer" name="Synthesizer" documentation="Egregore role: connects insights across domains."/>
    <element xsi:type="archimate:BusinessProcess" id="process-commons-governance" name="Commons Governance" documentation="Ostrom-principle operation: boundary rules, congruence, collective-choice, monitoring, graduated sanctions, conflict-resolution, recognized rights."/>
    <element xsi:type="archimate:BusinessProcess" id="process-evidence-competition" name="Evidence-Based Competition" documentation="Egregores compete based on governance efficiency and ecosystem integration. Influence flows to what works."/>
    <element xsi:type="archimate:BusinessProcess" id="process-reputation-update" name="Reputation Update" documentation="Continuous evidence tracking and reputation adjustment based on measurable outcomes."/>
    <element xsi:type="archimate:BusinessService" id="service-water-cycle" name="Water Cycle Service" documentation="Circular water management: tank, sensors, drip irrigation."/>
    <element xsi:type="archimate:BusinessService" id="service-food-production" name="Food Production Service" documentation="Soil management, composting, polyculture planning."/>
    <element xsi:type="archimate:BusinessService" id="service-energy-grid" name="Energy Grid Service" documentation="Solar powerbank, microgrid coordination, Raft consensus."/>
    <element xsi:type="archimate:BusinessService" id="service-knowledge" name="Knowledge Service" documentation="Genesis Brain knowledge graph, SurrealDB storage, MCP integration."/>
    <element xsi:type="archimate:BusinessObject" id="obj-ostrom-principles" name="Ostrom's 8 Principles" documentation="Empirical foundation for commons self-governance at any scale."/>
    <element xsi:type="archimate:BusinessObject" id="obj-holonic-structure" name="Holonic Structure" documentation="Micro-Holon (local biome) → Meso-Holon (regional) → Macro-Holon (global)."/>
    <element xsi:type="archimate:BusinessObject" id="obj-regeneration-metrics" name="Regeneration Metrics" documentation="Observable ecological outcomes used for proof-of-regeneration verification."/>
  </folder>
  <folder name="Application" id="folder-application" type="application">
    <element xsi:type="archimate:ApplicationComponent" id="app-genesis-brain" name="Genesis Brain" documentation="SurrealDB knowledge graph with vector embeddings, NARS epistemic truth values, and spatial addressing."/>
    <element xsi:type="archimate:ApplicationComponent" id="app-agent-skills" name="Agent Skills" documentation="SKILL.md encoded institutional knowledge packages for autonomous execution."/>
    <element xsi:type="archimate:ApplicationComponent" id="app-mcp" name="Model Context Protocol" documentation="Standardized agent-to-tool integration layer."/>
    <element xsi:type="archimate:ApplicationService" id="appserv-surrealdb" name="SurrealDB Service" documentation="Time-series + graph database for knowledge storage and retrieval."/>
    <element xsi:type="archimate:ApplicationService" id="appserv-kreuzberg" name="Kreuzberg Extraction" documentation="Document extraction from 75+ formats (PDF, Office, images, HTML, email)."/>
    <element xsi:type="archimate:ApplicationService" id="appserv-mcp-bridge" name="MCP Bridge" documentation="Connects OpenClaw agent runtime to MCP tool ecosystem."/>
    <element xsi:type="archimate:DataObject" id="data-concepts" name="Concept Graph" documentation="5,000+ concepts with vector embeddings and truth values."/>
    <element xsi:type="archimate:DataObject" id="data-sources" name="Source Documents" documentation="Canonical content from wiki sources, Telegram exports, research."/>
    <element xsi:type="archimate:DataObject" id="data-synthesis" name="Synthesis Documents" documentation="Cross-document synthesis producing thesis statements and claims."/>
  </folder>
  <folder name="Technology &amp; Physical" id="folder-technology" type="technology">
    <element xsi:type="archimate:Node" id="node-edge-hp" name="Edge Node (HP EliteBook)" documentation="HP EliteBook x360 1030 G3, 16GB RAM, 250GB SSD. Local VPS for Hermes, claw, web server."/>
    <element xsi:type="archimate:Device" id="device-soil-sensor" name="Soil Moisture Sensor" documentation="Soil moisture readings for drip irrigation decision support."/>
    <element xsi:type="archimate:Device" id="device-water-tank" name="Water Tank Sensor" documentation="Tank level monitoring for circular water management."/>
    <element xsi:type="archimate:SystemSoftware" id="sys-software-openclaw" name="OpenClaw Runtime" documentation="Agent runtime with wiki, memory, and channel integrations."/>
    <element xsi:type="archimate:SystemSoftware" id="sys-software-mesh" name="Mesh Radio" documentation="80-400ms latency communication across edge nodes."/>
    <element xsi:type="archimate:Artifact" id="art-sensor-data" name="Sensor Data Stream" documentation="Continuous readings from DHT22, soil moisture, water tank."/>
    <element xsi:type="archimate:Artifact" id="art-model-weights" name="AI Model Weights" documentation="GGUF format local LLM models for offline inference."/>
    <element xsi:type="archimate:Artifact" id="art-raft-log" name="Raft Consensus Log" documentation="Append-only log for leader election and state replication."/>
    <element xsi:type="archimate:CommunicationNetwork" id="net-mesh" name="Mesh Radio Network" documentation="P2P mesh radio for village-scale connectivity without internet."/>
    <element xsi:type="archimate:CommunicationNetwork" id="net-internet" name="Internet Backbone" documentation="Fallback connectivity for cross-village coordination."/>
  </folder>
  <folder name="Motivation" id="folder-motivation" type="motivation">
    <element xsi:type="archimate:Driver" id="driver-regenerative" name="Regenerative Development" documentation="Build circular systems that replace extractive patterns."/>
    <element xsi:type="archimate:Driver" id="driver-offline-first" name="Offline Resilience" documentation="Continue operation under total internet blackout."/>
    <element xsi:type="archimate:Goal" id="goal-circular-economy" name="Circular Economy" documentation="Water, food, energy, waste all circular with no external dependency."/>
    <element xsi:type="archimate:Goal" id="goal-governance" name="Self-Governance" documentation="Communities govern themselves via Ostrom-principle commons."/>
    <element xsi:type="archimate:Principle" id="principle-ostrom" name="Ostrom Compliance" documentation="All commons operations follow Ostrom's 8 principles."/>
    <element xsi:type="archimate:Principle" id="principle-openclaw" name="Open Architecture" documentation="No vendor lock-in. Self-hostable. P2P sync."/>
    <element xsi:type="archimate:Requirement" id="req-no-cloud" name="Cloud Independence" documentation="All operations continue without internet or cloud services."/>
    <element xsi:type="archimate:Requirement" id="req-mesh-sync" name="Mesh Sync" documentation="Knowledge syncs across edge nodes via mesh radio."/>
    <element xsi:type="archimate:Capability" id="cap-knowledge" name="Knowledge Infrastructure" documentation="Ability to ingest, store, retrieve, and synthesize community knowledge."/>
    <element xsi:type="archimate:Capability" id="cap-governance" name="Commons Governance" documentation="Ability to govern shared resources through evidence-based competition."/>
    <element xsi:type="archimate:Capability" id="cap-physical" name="Physical Operations" documentation="Ability to manage circular physical infrastructure (water, food, energy)."/>
    <element xsi:type="archimate:Resource" id="res-surrealdb" name="SurrealDB Knowledge Graph" documentation="Primary knowledge storage and retrieval system."/>
    <element xsi:type="archimate:Resource" id="res-openclaw" name="OpenClaw Agent Runtime" documentation="Agent orchestration for community operations."/>
    <element xsi:type="archimate:Resource" id="res-hp-edge" name="HP Edge Nodes" documentation="Local compute resources replacing cloud dependency."/>
  </folder>
  <folder name="Implementation &amp; Migration" id="folder-implementation_migration" type="implementation_migration">
    <element xsi:type="archimate:WorkPackage" id="wp-hetzner-migration" name="Migrate from Hetzner to Local" documentation="Replace Hetzner VPS with HP EliteBook edge nodes. Estimated 3 days per node."/>
  </folder>
</archimate:model>
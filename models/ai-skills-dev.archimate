<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="AI Skills Development" id="model-ai-skills-dev" version="1.0.0">
  <property key="domain" value="regenerative-community"/>
  <property key="layer" value="all"/>
  <folder name="Business" id="folder-business" type="business">
    <element xsi:type="archimate:BusinessActor" id="actor.learner" name="AI Learner" documentation="Community member pursuing AI certification"/>
    <element xsi:type="archimate:BusinessActor" id="actor.coordinator" name="Skills Coordinator" documentation="Community role that assigns tasks based on verified skills"/>
    <element xsi:type="archimate:BusinessProcess" id="process.enroll" name="Track Enrollment" documentation="Member registers interest and enrolls in training track"/>
    <element xsi:type="archimate:BusinessProcess" id="process.progress" name="Progress Update" documentation="Member updates course completion status"/>
    <element xsi:type="archimate:BusinessProcess" id="process.assign" name="Role Assignment" documentation="Coordinator assigns roles based on verified credentials"/>
    <element xsi:type="archimate:BusinessService" id="service.skills-registry" name="Community Skills Registry" documentation="Shared registry tracking member training progress and certifications"/>
    <element xsi:type="archimate:BusinessService" id="service.certification" name="Certification Verification Service" documentation="Verifies NVIDIA digital badges against official portal"/>
  </folder>
  <folder name="Application" id="folder-application" type="application">
    <element xsi:type="archimate:ApplicationComponent" id="app.genesis-brain" name="Genesis Brain" documentation="SurrealDB knowledge graph storing member skills and training records"/>
    <element xsi:type="archimate:ApplicationComponent" id="app.training-portal" name="NVIDIA Training Portal" documentation="Official NVIDIA developer portal for courses and exams"/>
    <element xsi:type="archimate:ApplicationComponent" id="app.badge-verifier" name="Badge Verifier" documentation="NVIDIA Digital Badge verification interface"/>
  </folder>
  <folder name="Technology &amp; Physical" id="folder-technology" type="technology">
    <element xsi:type="archimate:Node" id="node.edge-hp" name="HP EliteBook Edge Node" documentation="Local VPS hosting Genesis Brain and training cache"/>
    <element xsi:type="archimate:Node" id="node.nvidia-cloud" name="NVIDIA Cloud Infrastructure" documentation="GPU servers for AI training and certification exams"/>
    <element xsi:type="archimate:SystemSoftware" id="sw.surrealdb" name="SurrealDB" documentation="Graph database for skills registry"/>
    <element xsi:type="archimate:Artifact" id="art.training-content" name="Training Content Cache" documentation="Downloaded NVIDIA courses for offline field use"/>
    <element xsi:type="archimate:Artifact" id="art.skills-graph" name="Skills Knowledge Graph" documentation="SurrealDB graph storing certifications and training paths"/>
  </folder>
  <folder name="Motivation" id="folder-motivation" type="motivation">
    <element xsi:type="archimate:Goal" id="goal.skills-framework" name="Establish Verified AI Skills Framework" documentation="Create a community认可的AI技能认证体系"/>
    <element xsi:type="archimate:Principle" id="prin.open-access" name="Open Access Entry" documentation="Free content tracks lower barrier to entry"/>
    <element xsi:type="archimate:Requirement" id="req.nvidia-align" name="NVIDIA Certification Alignment" documentation="Align with industry-standard NVIDIA certification tiers"/>
    <element xsi:type="archimate:Requirement" id="req.progress-tracking" name="Progress Tracking" documentation="Track member progress from interest to certification"/>
  </folder>
</archimate:model>